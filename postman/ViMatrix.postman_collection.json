  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Collection level Post-response script\r",
          "// Runs after EVERY request in this collection\r",
          "// Automatically captures tokens and IDs\r",
          "\r",
          "const res = pm.response.json();\r",
          "\r",
          "// Auto-save accessToken after login or refresh\r",
          "if (res?.data?.accessToken) {\r",
          "  pm.environment.set(\"accessToken\", res.data.accessToken);\r",
          "  console.log(\"✅ accessToken saved\");\r",
          "}\r",
          "\r",
          "// Auto-save refreshToken\r",
          "if (res?.data?.refreshToken) {\r",
          "  pm.environment.set(\"refreshToken\", res.data.refreshToken);\r",
          "  console.log(\"✅ refreshToken saved\");\r",
          "}\r",
          "\r",
          "// Auto-save userId after login\r",
          "if (res?.data?.user?._id) {\r",
          "  pm.environment.set(\"userId\", res.data.user._id);\r",
          "  console.log(\"✅ userId saved:\", res.data.user._id);\r",
          "}\r",
          "\r",
          "// Auto-save videoId after video creation\r",
          "if (res?.data?._id && pm.request.url.toString().includes(\"/videos\")) {\r",
          "  pm.environment.set(\"videoId\", res.data._id);\r",
          "  console.log(\"✅ videoId saved:\", res.data._id);\r",
          "}\r",
          "\r",
          "// Auto-save commentId after comment creation\r",
          "if (res?.data?._id && pm.request.url.toString().includes(\"/comments\")) {\r",
          "  pm.environment.set(\"commentId\", res.data._id);\r",
          "  console.log(\"✅ commentId saved:\", res.data._id);\r",
          "}\r",
          "\r",
          "// Auto-save tweetId after tweet creation\r",
          "if (res?.data?._id && pm.request.url.toString().includes(\"/tweets\")) {\r",
          "  pm.environment.set(\"tweetId\", res.data._id);\r",
          "  console.log(\"✅ tweetId saved:\", res.data._id);\r",
          "}\r",
          "\r",
          "// Auto-save playlistId after playlist creation\r",
          "if (res?.data?._id && pm.request.url.toString().includes(\"/playlist\")) {\r",
          "  pm.environment.set(\"playlistId\", res.data._id);\r",
          "  console.log(\"✅ playlistId saved:\", res.data._id);\r",
          "}"
        ],
        "type": "text/javascript",
        "packages": {}
      }
    }
  ]
