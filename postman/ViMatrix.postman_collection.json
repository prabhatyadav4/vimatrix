        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Login successful\", () => {\r",
                  "  pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Has access token\", () => {\r",
                  "  pm.expect(res.data.accessToken).to.be.a(\"string\");\r",
                  "  pm.expect(res.data.accessToken).to.include(\"eyJ\");\r",
                  "});\r",
                  "\r",
                  "// Save all auth data\r",
                  "if (res.data?.accessToken) {\r",
                  "  pm.environment.set(\"accessToken\",  res.data.accessToken);\r",
                  "  pm.environment.set(\"refreshToken\", res.data.refreshToken);\r",
                  "  pm.environment.set(\"userId\",       res.data.user._id);\r",
                  "  pm.environment.set(\"channelId\",    res.data.user._id);\r",
                  "  console.log(\"✅ Logged in as:\", res.data.user.username);\r",
                  "  console.log(\"✅ Tokens saved to environment\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
